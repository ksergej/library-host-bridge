{
  "family": "loan-query-service",
  "networkMode": "bridge",
  "requiresCompatibilities": ["EC2"],
  "containerDefinitions": [
    {
      "name": "loan-query",
      "image": "IMAGE_URI",
      "essential": true,
      "cpu": 256,
      "memory": 512,
      "portMappings": [
        { "containerPort": 8080, "hostPort": 0, "protocol": "tcp" }
      ]
    }
  ]
}
