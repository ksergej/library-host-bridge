//LIBDATA  JOB (ACCT),'DB2 DATA',
//          CLASS=A,MSGCLASS=X,NOTIFY=&SYSUID
//*-------------------------------------------------------------*
//*  Apply schema.sql via DSNTEP2
//*  Tokens: HLQ, DB2LOAD, DB2SS
//*-------------------------------------------------------------*
//VARS   SET HLQ={{ hlq }}
//       SET SQLPDS=&HLQ..SQL
//       SET DB2LOAD={{ db2.loadlib }}
//*-------------------------------------------------------------*
//*
//STEP1   EXEC PGM=IKJEFT01,DYNAMNBR=20
//STEPLIB DD  DSN=&DB2LOAD,DISP=SHR
//SYSTSPRT DD SYSOUT=*
//SYSOUT   DD SYSOUT=*
//SYSPRINT DD SYSOUT=*
//SYSUDUMP DD DUMMY
//SYSTSIN  DD *
  DSN SYSTEM(DBDG)
  RUN  PROGRAM(DSNTEP2) PLAN(DSNTEPD1) +
       LIB('DSND10.DBDG.RUNLIB.LOAD') PARMS('/ALIGN(MID)')
  END
